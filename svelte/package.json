{
  "name": "svelte-mpa-app",
  "version": "0.0.0",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "start": "npm run dev",
    "watch": "npm run build -- --watch",
    "dev": "node build.js --watch --serve",
    "build": "node build.js",
    "build:prod": "node build.js --minify",
    "serve": "node build.js --serve"
  },
  "devDependencies": {
    "chokidar": "^5.0.0",
    "esbuild": "^0.28.1",
    "esbuild-svelte": "^0.9.5",
    "parse5": "^8.0.1",
    "prettier": "^3.9.5",
    "svelte": "^5.56.4",
    "svelte-preprocess": "^6.0.5",
    "typescript": "^6.0.3"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "es5",
    "printWidth": 120,
    "arrowParens": "avoid"
  }
}
